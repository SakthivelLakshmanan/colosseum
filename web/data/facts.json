{"FIN-01": {"fact_id": "FIN-01", "domain": "finance", "topic": "volume", "statement": "Legion Capital processed 10.0 million payment transactions worth about ₹1,500 crore in September 2026 (average ₹1,500).", "entity": "Legion Capital", "metric": "monthly_payment_volume", "value_num": 1500, "value_text": "", "unit": "INR crore / month", "as_of": "2026-09-30", "superseded_by": "", "source_type": "table", "source_ref": "transactions_monthly", "reliability": "high"}, "FIN-02": {"fact_id": "FIN-02", "domain": "finance", "topic": "fees", "statement": "Arvanta Payments charges a blended fee of 0.20% of payment volume.", "entity": "Arvanta Payments", "metric": "blended_fee_pct", "value_num": 0.2, "value_text": "", "unit": "% of volume", "as_of": "2023-04-01", "superseded_by": "", "source_type": "document", "source_ref": "Arvanta_MSA_Excerpt.pdf §4.1", "reliability": "high"}, "FIN-03": {"fact_id": "FIN-03", "domain": "finance", "topic": "fees", "statement": "Brevis Pay's final quote (15 Sep 2026) is a blended fee of 0.176% of volume, 12% below Arvanta.", "entity": "Brevis Pay", "metric": "blended_fee_pct", "value_num": 0.176, "value_text": "", "unit": "% of volume", "as_of": "2026-09-15", "superseded_by": "", "source_type": "document", "source_ref": "Brevis_Draft_Agreement.pdf Schedule 1", "reliability": "high"}, "FIN-04": {"fact_id": "FIN-04", "domain": "finance", "topic": "fees", "statement": "Brevis Pay's India-only hosting add-on, needed to keep fraud scoring in India, costs a flat ₹6 lakh a month.", "entity": "Brevis Pay", "metric": "india_hosting_addon", "value_num": 6, "value_text": "", "unit": "INR lakh / month", "as_of": "2026-09-15", "superseded_by": "", "source_type": "document", "source_ref": "Brevis_Draft_Agreement.pdf Schedule 1 item 4", "reliability": "high"}, "FIN-05": {"fact_id": "FIN-05", "domain": "finance", "topic": "one_time_cost", "statement": "The one-time cost of migrating to Brevis Pay (engineering, certification, testing) is estimated at ₹40 lakh.", "entity": "Legion Capital", "metric": "migration_cost", "value_num": 40, "value_text": "", "unit": "INR lakh one-time", "as_of": "2026-09-25", "superseded_by": "", "source_type": "document", "source_ref": "Ops_Review_Q3_2026.pdf §5", "reliability": "medium"}, "FIN-06": {"fact_id": "FIN-06", "domain": "finance", "topic": "treasury", "statement": "Treasury estimates that Brevis Pay's T+1 card settlement (vs Arvanta's T+2) would cut funding cost by about ₹4 lakh a month on the 40% slice.", "entity": "Brevis Pay", "metric": "float_benefit", "value_num": 4, "value_text": "", "unit": "INR lakh / month", "as_of": "2026-09-24", "superseded_by": "", "source_type": "document", "source_ref": "Board_Minutes_Sep2026.pdf item 3", "reliability": "medium"}, "FIN-07": {"fact_id": "FIN-07", "domain": "finance", "topic": "treasury", "statement": "Legion Capital's cost of funds is 9.5% a year.", "entity": "Legion Capital", "metric": "cost_of_funds_pct", "value_num": 9.5, "value_text": "", "unit": "% per year", "as_of": "2026-09-24", "superseded_by": "", "source_type": "document", "source_ref": "Board_Minutes_Sep2026.pdf item 3", "reliability": "high"}, "FIN-08": {"fact_id": "FIN-08", "domain": "finance", "topic": "fees", "statement": "Dispute handling fees: Arvanta ₹150 and Brevis ₹250 per dispute. About 2,000 disputes a month arise on the 40% slice.", "entity": "Brevis Pay", "metric": "dispute_fee_delta", "value_num": 2, "value_text": "", "unit": "INR lakh / month", "as_of": "2026-09-15", "superseded_by": "", "source_type": "document", "source_ref": "Brevis_Draft_Agreement.pdf Schedule 1 item 2; Arvanta_MSA_Excerpt.pdf §4.3; Ops_Review_Q3_2026.pdf §1", "reliability": "high"}, "FIN-09": {"fact_id": "FIN-09", "domain": "finance", "topic": "budget", "statement": "FY27 payments-cost budget is ₹33 crore; the current run-rate is ₹36 crore a year (9% over budget).", "entity": "Legion Capital", "metric": "payments_cost_run_rate", "value_num": 36, "value_text": "", "unit": "INR crore / year"